{
  "name": "catsnap",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host --mode phone",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "android:sync": "npm run build:native && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease && cp app/build/outputs/apk/release/app-release.apk ../releases/catsnap-$npm_package_version.apk",
    "build:native": "tsc -b && vite build --mode native"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/camera": "7.0.5",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/geolocation": "^7.1.4",
    "@capacitor/share": "^7.0.2",
    "@fontsource/bricolage-grotesque": "5.2.10",
    "@fontsource/figtree": "5.2.10",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@supabase/supabase-js": "2.117.3",
    "idb": "8.0.0",
    "leaflet": "1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-easy-crop": "6.2.3",
    "react-leaflet": "4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@types/leaflet": "1.9.12",
    "@types/node": "^22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-basic-ssl": "1.2.0",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "6.0.0",
    "typescript": "5.6.3",
    "vite": "6.0.7",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
